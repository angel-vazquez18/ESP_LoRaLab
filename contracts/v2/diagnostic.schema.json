        "device_id": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "boot_id": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Boot Id",
          "type": "string"
