(footprint "SW_TACTILE_6x6x8_REFERENCE_FIT_PENDING" (version 20260206) (generator "pcbnew") (layer "F.Cu")
(descr "6x6x8mm tactile; reference 6.5x4.5mm contacts, 2mm pads, 1.1mm drills. Verify owned-part fit and contact pairing.")
(attr through_hole)
(fp_text reference "REF**" (at 0 -3) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
(fp_text value "SW_TACTILE_6x6x8_REFERENCE_FIT_PENDING" (at 0 3) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
(fp_rect (start -3 -3) (end 3 3) (stroke (width 0.15) (type default)) (fill none) (layer "F.Fab"))
(fp_rect (start -4.5 -3.5) (end 4.5 3.5) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
(fp_text user "PTT" (at 0 0) (layer "F.Fab") (effects (font (size 1.1 1.1) (thickness 0.16))))
(pad "1" thru_hole rect (at -3.25 -2.25) (size 2 2) (drill 1.1) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
(pad "1" thru_hole rect (at 3.25 -2.25) (size 2 2) (drill 1.1) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
(pad "2" thru_hole circle (at -3.25 2.25) (size 2 2) (drill 1.1) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
(pad "2" thru_hole circle (at 3.25 2.25) (size 2 2) (drill 1.1) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
(model "${KIPRJMOD}/models/SW_PUSH_6mm_H8mm.step" (offset (xyz -3.25 2.25 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)